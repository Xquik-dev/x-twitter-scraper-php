#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Xquik contributors
#
# SPDX-License-Identifier: Apache-2.0

# Releases the Composer package from a maintainer machine.
# Packagist reads the pushed tag from GitHub, so this script needs no registry credential.

set -euo pipefail

cd -- "$(dirname -- "$0")/.."

readonly repository="Xquik-dev/x-twitter-scraper-php"
readonly package="xquik/x-twitter-scraper"

step() {
  echo "==> $1"
}

refuse() {
  echo "release-local: $1" >&2
  exit 1
}

step "Checking required tools"
for tool in composer curl gh git jq php; do
  command -v "$tool" >/dev/null 2>&1 || refuse "${tool} is missing. Install it, then run bin/release-local again."
done
gh auth status --hostname github.com >/dev/null 2>&1 || refuse "gh is signed out. Run gh auth login, then try again."

step "Checking that the working tree is clean"
[[ -z "$(git status --porcelain)" ]] || refuse "The working tree has changes. Commit or remove them first."

step "Checking that main is checked out"
[[ "$(git symbolic-ref --quiet --short HEAD || true)" == "main" ]] || refuse "Release from main. Run git switch main first."

step "Checking that main matches origin/main"
git fetch --quiet origin main || refuse "Could not fetch origin. Check your network and GitHub access."
[[ "$(git rev-parse HEAD)" == "$(git rev-parse refs/remotes/origin/main)" ]] ||
  refuse "main differs from origin/main. Pull or push until they match."

step "Reading the version from .release-please-manifest.json"
version="$(jq -er '."." | strings' .release-please-manifest.json)" ||
  refuse "Could not read the version from .release-please-manifest.json. Check its JSON."
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z][0-9A-Za-z.-]*)?$ ]] ||
  refuse "The manifest version '${version}' is invalid. Fix .release-please-manifest.json."
sdk_version="$(php -r 'require "src/Version.php"; echo \XTwitterScraper\VERSION;')" ||
  refuse "Could not read src/Version.php. Check its syntax."
[[ "$sdk_version" == "$version" ]] ||
  refuse "src/Version.php says ${sdk_version} but the manifest says ${version}. Align them first."
tag="v${version}"

step "Checking that tag ${tag} is new"
remote_tag="$(git ls-remote --tags origin "refs/tags/${tag}")" ||
  refuse "Could not list tags on origin. Check your network and GitHub access."
[[ -z "$remote_tag" ]] || refuse "Tag ${tag} already exists on origin. Bump the version first."
if git rev-parse --quiet --verify "refs/tags/${tag}" >/dev/null; then
  refuse "Tag ${tag} exists only locally. Delete it with git tag -d ${tag}, then try again."
fi

step "Reading release notes for ${version} from CHANGELOG.md"
notes="$(awk -v heading="## ${version}" '
  $0 == heading || index($0, heading " ") == 1 { found = 1; next }
  found && /^## / { exit }
  found { print }
' CHANGELOG.md | sed '/./,$!d')"
[[ -n "${notes//[[:space:]]/}" ]] || refuse "CHANGELOG.md has no notes for ${version}. Add them first."

step "Looking for a draft GitHub release for ${tag}"
draft_ids="$(gh api --paginate "repos/${repository}/releases?per_page=100" \
  --jq ".[] | select(.draft and .tag_name == \"${tag}\") | .id")" ||
  refuse "Could not list GitHub releases. Run gh auth status, then try again."
draft_count="$(grep -c . <<<"$draft_ids" || true)"
[[ "$draft_count" -le 1 ]] || refuse "GitHub has ${draft_count} draft releases for ${tag}. Delete the extras first."

workspace="$(mktemp -d "${TMPDIR:-/tmp}/xquik-php-release.XXXXXX")"
trap 'rm -rf -- "${workspace:?}"' EXIT
notes_file="$workspace/notes.md"
printf '%s\n' "$notes" >"$notes_file"
archive="$workspace/x-twitter-scraper-php-${tag}.zip"

step "Running bin/check-local"
./bin/check-local || refuse "bin/check-local failed. Fix the check it names, then try again."

step "Auditing locked dependencies"
composer audit --locked --abandoned=fail --format=plain ||
  refuse "composer audit found a vulnerable or abandoned package. Update it first."

step "Building the Composer archive"
./scripts/build-archive "$archive" || refuse "The Composer archive build failed. Fix the error above."

step "Checking whether Packagist already lists ${version}"
packagist_metadata="$(curl --fail --silent --show-error --proto '=https' --tlsv1.2 --max-time 30 \
  "https://repo.packagist.org/p2/${package}.json")" ||
  refuse "Could not read Packagist metadata. Check your network, then try again."
packagist_versions="$(jq -er '.packages[] | .[].version' <<<"$packagist_metadata")" ||
  refuse "Packagist returned unreadable metadata. Try again later."
if grep -Fxq -e "v${version}" -e "${version}" <<<"$packagist_versions"; then
  echo "Packagist already lists ${version}. Skipping the upload, tag and GitHub release."
  exit 0
fi

step "Creating annotated tag ${tag}"
git tag --annotate "$tag" --message "Release ${tag}"

step "Pushing tag ${tag} so Packagist reads it from GitHub"
git push origin "refs/tags/${tag}"

release_flags=(--latest)
if [[ "$version" == *-* ]]; then
  release_flags=(--prerelease --latest=false)
fi

if [[ -n "$draft_ids" ]]; then
  step "Publishing the draft GitHub release for ${tag}"
  gh release upload "$tag" "$archive" --repo "$repository" --clobber
  gh release edit "$tag" \
    --repo "$repository" \
    --title "$tag" \
    --notes-file "$notes_file" \
    --draft=false \
    --verify-tag \
    "${release_flags[@]}"
else
  step "Creating GitHub release ${tag}"
  gh release create "$tag" "$archive" \
    --repo "$repository" \
    --title "$tag" \
    --notes-file "$notes_file" \
    --verify-tag \
    "${release_flags[@]}"
fi

echo "Released ${tag}. Packagist picks up the new tag from GitHub."
