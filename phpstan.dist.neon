parameters:
    level: max
    phpVersion:
        min: 80100
        max: 80599
    paths:
        - src
        - tests
    ignoreErrors:
        - identifier: parameter.defaultValue
        - identifier: trait.unused
        - identifier: property.onlyWritten

    reportUnmatchedIgnoredErrors: false

services:
    -
        class: Tests\Support\NoCodeCommentsRule
        arguments:
            root: %currentWorkingDirectory%
            publicApiFolders: [src/]
            privateApiFolders: [src/Core/]
        tags:
            - phpstan.rules.rule
