#!/usr/bin/env bash

set -euo pipefail

cd -- "$(dirname -- "$0")/.."

coverage_workspace="$(mktemp -d "${TMPDIR:-/tmp}/xquik-php-coverage.XXXXXX")"
chmod 700 "$coverage_workspace"
trap 'rm -rf -- "$coverage_workspace"' EXIT

if ! php -r 'exit(extension_loaded("xdebug") ? 0 : 1);'; then
  echo "Xdebug is required for branch coverage." >&2
  exit 1
fi

echo "==> Measuring runtime core and service coverage"
batch_files=()
batch_index=0
coverage_batch_size=8

run_coverage_batch() {
  batch_index=$((batch_index + 1))
  coverage_part="$coverage_workspace/coverage-${batch_index}.cov"

  echo "==> Collecting coverage batch ${batch_index}"
  XDEBUG_MODE=coverage PHPUNIT_MEMORY_LIMIT=1G ./scripts/test \
    --path-coverage \
    --coverage-php="$coverage_part" \
    "${batch_files[@]}"

  batch_files=()
}

while IFS= read -r test_file; do
  batch_files+=("$test_file")
  # Bound Xdebug path data to prevent native crashes on large suites.
  if ((${#batch_files[@]} == coverage_batch_size)); then
    run_coverage_batch
  fi
done < <(find tests -type f -name '*Test.php' | LC_ALL=C sort)

if ((${#batch_files[@]} > 0)); then
  run_coverage_batch
fi

vendor/bin/phpcov merge \
  --cobertura "$coverage_workspace/cobertura.xml" \
  "$coverage_workspace"

php scripts/verify-coverage.php "$coverage_workspace/cobertura.xml"
